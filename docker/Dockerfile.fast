FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    VIRTUAL_ENV=/opt/ctf-venv \
    PATH=/opt/ctf-venv/bin:$PATH \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates git curl wget jq ripgrep vim-tiny \
    file binutils elfutils build-essential cmake \
    gdb gdb-multiarch ltrace strace patchelf \
    netcat-openbsd nmap tcpdump tshark dnsutils iproute2 openssl \
    python3 python3-dev python3-venv \
    libssl-dev libffi-dev libgmp-dev libmpfr-dev libmpc-dev libmagic1 \
    binwalk foremost sleuthkit libimage-exiftool-perl steghide pngcheck imagemagick \
    ffmpeg sox tesseract-ocr \
    zip unzip p7zip-full xz-utils sqlite3 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv "$VIRTUAL_ENV" \
    && pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir \
       pwntools \
       pycryptodome \
       z3-solver \
       sympy \
       gmpy2 \
       requests \
       beautifulsoup4 \
       lxml \
       Pillow \
       capstone \
       unicorn \
       ropgadget \
       ropper \
       scapy \
       python-magic \
       construct \
       numpy \
       scipy \
       volatility3

RUN useradd --create-home --uid 1000 --shell /bin/bash ctf \
    && mkdir -p /challenge \
    && chown ctf:ctf /challenge

USER ctf
WORKDIR /challenge
CMD ["/bin/bash"]
